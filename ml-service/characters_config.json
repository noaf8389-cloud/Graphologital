{
  "preprocessing": {
    "kernel_size": [2, 2],
    "adaptive_block_size": 11,
    "adaptive_c": 2,
    "max_hole_area": 20
  },

  "contours": {
    "min_contour_area": 150
  },

  "line_sorting": {
    "line_alpha": 0.3,
    "line_margin_ratio": 0.5
  },

  "merge": {
    "contained_margin": 8,
    "contained_confidence_ratio": 0.7,

    "regular_max_width_height_ratio": 1.8,
    "regular_gap_min": 15,
    "regular_gap_width_ratio": 1.0,
    "regular_confidence_ratio": 1.0,

    "skip_merge_gap_multiplier": 2.0
  },

  "split": {
    "min_width": 30,
    "min_height": 25,
    "min_width_height_ratio": 0.75,

    "suspect_width_height_ratio": 1.3,
    "suspect_confidence": 60,

    "high_original_confidence": 70,
    "high_original_width_height_ratio": 1.45,
    "high_min_confidence": 75,
    "high_avg_improvement": 3,

    "low_min_confidence": 55,
    "low_min_improvement_ratio": 1.1
  },

  "cut": {
    "start_ratio": 0.25,
    "end_ratio": 0.75,
    "candidate_count": 12,
    "min_component_ratio": 0.07,
    "ink_ratio_max": 0.55,
    "thickness_ratio_max": 1.0,
    "score_thickness_weight": 0.65,
    "score_ink_weight": 0.35
  },

  "display": {
    "scale": 0.4,
    "show_steps": true,
    "debug_prints": false
  },

  "max_split_depth": 3
}